{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "birthday-glow",
	"main": "worker/index.mjs",
	"compatibility_date": "2026-10-13",
	"workers_dev": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/_app/health"
		],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "birthday-glow-db",
			"database_id": "c7eb02d2-c055-436e-9396-deb9ebe3aa9c",
			"migrations_dir": "migrations",
		},
		{
			"binding": "birthday_glow_db",
			"database_name": "birthday-glow-db",
			"database_id": "c7eb02d2-c055-436e-9396-deb9ebe3aa9c"
		},
	],
	"observability": {
		"enabled": true,
	},
}