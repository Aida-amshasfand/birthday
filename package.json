{
  "name": "birthday-glow-workers",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.13.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "db:local": "wrangler d1 migrations apply birthday-glow-db --local",
    "db:remote": "wrangler d1 migrations apply birthday-glow-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.150.0"
  }
}
